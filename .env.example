# ViralBrandEngine — Environment Variables
# ==========================================
# Copy this to .env and fill in your real keys.

# ── App ──────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG
API_KEY=replace-with-a-long-random-api-key
ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
API_KEY=replace-with-a-long-random-api-key
ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
CORS_ORIGINS=http://localhost:8000

# ── Database ─────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/viral_brand_engine

# ── Redis / Celery ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ───────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# ── AI video generation (optional) ─────────
# Kling is preferred when configured, followed by Luma and Google Gemini.
KLING_API_KEY=
LUMA_API_KEY=
GOOGLE_FLOW_API_KEY=
GEMINI_API_KEY=

# ── ElevenLabs ───────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Pexels (B-Roll Stock Video) ─────────
PEXELS_API_KEY=your-pexels-key-here

# ── Runway ML (optional) ────────────────
RUNWAY_API_KEY=

# ── Meta / Instagram Reels ──────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=

# ── TikTok ───────────────────────────────
TIKTOK_ACCESS_TOKEN=
PUBLIC_MEDIA_BASE_URL=https://media.example.com/renders
